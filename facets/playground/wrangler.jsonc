// facets.preset.nz: static assets only, no Worker code.
// Deploy with `just playground-deploy` from the package root.
{
  "name": "facets-playground",
  "compatibility_date": "2026-09-26",
  "routes": [{ "pattern": "facets.preset.nz", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
