{
  "version": 1,
  "pages": [
    {
      "id": "general",
      "label": "General",
      "summary": "How the app looks and what it opens with."
    },
    {
      "id": "library",
      "label": "Library",
      "summary": "Where images live and how long deleted ones stay."
    }
  ],
  "sections": [
    {
      "id": "appearance",
      "label": "Appearance",
      "page": "general"
    },
    {
      "id": "library",
      "label": "Library",
      "page": "library"
    },
    {
      "id": "cache",
      "label": "Cache",
      "page": "library",
      "advanced": true
    },
    {
      "id": "trash",
      "label": "Trash",
      "page": "library"
    }
  ],
  "prefs": [
    {
      "id": "appearance.theme",
      "label": "Theme",
      "help": "Follow the system, or pin one look.",
      "kind": "select",
      "options": [
        {
          "value": "system",
          "label": "System"
        },
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "system"
    },
    {
      "id": "appearance.reopen",
      "label": "Reopen last library",
      "kind": "bool",
      "default": true
    },
    {
      "id": "library.root",
      "label": "Library folder",
      "help": "Where the originals are kept.",
      "kind": "readonly_path",
      "default": "/Users/someone/Pictures/Library"
    },
    {
      "id": "library.extensions",
      "label": "File types",
      "help": "Extensions picked up on import.",
      "kind": "list",
      "default": [
        "jpg",
        "png"
      ]
    },
    {
      "id": "cache.size_mb",
      "label": "Thumbnail cache",
      "help": "Megabytes kept for thumbnails before the oldest go.",
      "kind": "int",
      "min": 64,
      "max": 4096,
      "default": 512
    },
    {
      "id": "cache.quality",
      "label": "Preview quality",
      "kind": "float",
      "min": 0.1,
      "max": 1.0,
      "default": 0.8
    },
    {
      "id": "trash.retention_days",
      "label": "Keep deleted images for",
      "help": "Days before the Trash is emptied for good.",
      "kind": "int",
      "min": 1,
      "max": 365,
      "default": 30
    }
  ]
}
