default:
    @just --list

# Fetch dependencies and install the git hooks
[group('setup')]
install:
    cargo fetch

# Format, lint, test and build the docs, with and without the rhizome adapter: the fast signal
[group('quality')]
check:
    cargo fmt --check
    cargo clippy --all-targets --all-features -- -D warnings
    cargo clippy --all-targets -- -D warnings
    cargo test --all-features
    RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --all-features

# Run the tests
[group('quality')]
test *args:
    cargo test --all-features {{args}}

# Regenerate the golden pages. Read every changed golden before committing
[group('quality')]
bless:
    PRESET_DOCS_BLESS=1 cargo test --all-features --test docs --test preferences
    git status --short tests

# Format the code
[group('dev')]
fmt:
    cargo fmt

# Pages from a catalogue as JSON: `just docs <catalogue.json> <out-dir> [--check] [--app <name>]`
[group('docs')]
docs *args:
    cargo run -q -- {{args}}
